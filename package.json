{
  "name": "open-parcels-workspace",
  "private": true,
  "description": "Self-hosted parcel and order tracking: one backend for every carrier, shop and mailbox.",
  "homepage": "https://open-parcels.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-parcels/open-parcels.git"
  },
  "bugs": {
    "url": "https://github.com/open-parcels/open-parcels/issues"
  },
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "node --max-old-space-size=2560 node_modules/eslint/bin/eslint.js --max-warnings 0 .",
    "knip": "knip --no-progress --no-gitignore",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "format": "prettier --write --ignore-path .prettierignore .",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "hooks": "git config core.hooksPath tools/hooks",
    "providers": "node server/src/tools/providers.ts",
    "postinstall": "node server/src/tools/providers.ts",
    "gate": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm run test && npm run build"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.73.0"
  }
}
